        { "name": "Criar Agendamento", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"usuarioId\": \"11111111-1111-1111-1111-111111111111\",\n  \"servicoId\": 1,\n  \"profissionalId\": 1,\n  \"data\": \"2026-02-10T14:30:00Z\"\n}" }, "url": { "raw": "{{baseUrl}}/api/Agendamentos", "host": ["{{baseUrl}}"], "path": ["api","Agendamentos"] } } },
        { "name": "Atualizar Agendamento", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id\": \"22222222-2222-2222-2222-222222222222\",\n  \"usuarioId\": \"11111111-1111-1111-1111-111111111111\",\n  \"servicoId\": 1,\n  \"profissionalId\": 1,\n  \"data\": \"2026-02-11T10:00:00Z\"\n}" }, "url": { "raw": "{{baseUrl}}/api/Agendamentos", "host": ["{{baseUrl}}"], "path": ["api","Agendamentos"] } } }
