        { "name": "Criar Profissional", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Maria\"\n}" }, "url": { "raw": "{{baseUrl}}/api/profissionais", "host": ["{{baseUrl}}"], "path": ["api","profissionais"] } } }
